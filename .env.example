# No credentials are supplied. Review routes are disabled until a token is set.
DATABASE_PATH=data/energytool.db
# Compose uses its internal PostgreSQL service by default. URL is optional.
DATABASE_URL=
POSTGRES_PASSWORD=energytool-local
API_PORT=8000
FRONTEND_PORT=8080
# Local judge/debug access. Rebuild frontend after changing this flag.
# Requires a nonempty REVIEW_TOKEN; Compose publishes the UI on localhost.
ENABLE_REVIEW=false
INDEX_DIR=private/index
# Used by the optional ingest tool; keep raw materials outside the Git checkout.
CORPUS_DIR_HOST=../files/corpus
REVIEW_TOKEN=
CORS_ORIGINS=http://localhost:5173
ML_TIMEOUT_SECONDS=10
TURN_LEASE_SECONDS=30
SYNC_WAIT_SECONDS=0.5
REQUESTS_PER_MINUTE=120
MAX_BODY_BYTES=32768
# Disabled by default. Configure only an authorized endpoint for the private corpus.
LLM_ENABLED=false
ALLOW_PRIVATE_CORPUS_TO_LLM=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_ALLOW_INTERNAL_HTTP=false
LLM_GENERATION_MODE=grounded
LLM_MAX_RETRIES=2
TEMPERATURE=0
MAX_TOKENS=2048
# Hybrid retrieval is enabled with LLM_ENABLED; offline mode stays local BM25.
RETRIEVAL_MODE=hybrid
TOP_K=6
RETRIEVAL_CANDIDATES=20
RRF_K=60
LEXICAL_WEIGHT=1
DENSE_WEIGHT=1
RETRIEVAL_TIMEOUT_SECONDS=8
# The model ID comes from the organizer; this is the sample's default.
EMB_MODEL=baai/bge-m3
EMBEDDER_API_KEY=
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=2
EMBEDDING_MODEL_REVISION=
EMBEDDING_DIMENSIONS=
# Optional writable private directory; blank means memory-only vectors.
EMBEDDING_CACHE_DIR=/cache
# Optional aliases; primary LLM_* values take precedence when nonempty.
BASE_URL=
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
GEN_MODEL=
