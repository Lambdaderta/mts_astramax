# mock (default) | api. /demo always remains available with isolated mocks.
VITE_DATA_SOURCE=mock
# Leave blank until backend is ready. Empty = same-origin /api/v1.
VITE_API_BASE_URL=
# Optional development/preview reverse proxy target, e.g. http://127.0.0.1:8000
API_PROXY_TARGET=
# Review is off by default. Requires a protected same-origin gateway.
VITE_ENABLE_REVIEW=false
VITE_REVIEW_BASE_URL=/review-api/v1
# SERVER ONLY. Never rename this to VITE_REVIEW_TOKEN.
REVIEW_TOKEN=
