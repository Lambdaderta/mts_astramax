server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location = /health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /api/ {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $api_upstream ${API_UPSTREAM};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 130s;
        proxy_send_timeout 130s;
    }

    location /api/v1/review/ {
        return 403;
    }

    location /review-api/v1/ {
        set $review_enabled "${ENABLE_REVIEW}";
        set $review_auth "Bearer ${REVIEW_TOKEN}";
        if ($review_enabled != "true") { return 403; }
        if ($review_auth = "Bearer ") { return 403; }
        limit_except GET { deny all; }
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $api_upstream ${API_UPSTREAM};
        rewrite ^/review-api/v1/(.*)$ /api/v1/review/$1 break;
        proxy_pass $api_upstream;
        proxy_set_header Authorization $review_auth;
        proxy_set_header Host $host;
        proxy_hide_header Authorization;
    }

    location /review-api/ {
        return 403;
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
