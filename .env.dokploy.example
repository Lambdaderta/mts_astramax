# Copy this into Dokploy Environment. Replace only the two CHANGE_ME values.
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_DATABASE_PASSWORD
API_PORT=8000
FRONTEND_PORT=8080
ENABLE_REVIEW=false
REVIEW_TOKEN=

LLM_ENABLED=true
ALLOW_PRIVATE_CORPUS_TO_LLM=true
LLM_BASE_URL=https://api.proxyapi.ru/v1
LLM_API_KEY=CHANGE_ME_PROXYAPI_KEY
LLM_MODEL=qwen/qwen3.8-27b
LLM_ALLOW_INTERNAL_HTTP=false
LLM_GENERATION_MODE=grounded
LLM_MAX_RETRIES=2
ML_TIMEOUT_SECONDS=30
TURN_LEASE_SECONDS=45
SYNC_WAIT_SECONDS=0.5
TEMPERATURE=0
MAX_TOKENS=8192

RETRIEVAL_MODE=hybrid
TOP_K=6
RETRIEVAL_CANDIDATES=20
RRF_K=60
LEXICAL_WEIGHT=1
DENSE_WEIGHT=1
RETRIEVAL_TIMEOUT_SECONDS=8
EMB_MODEL=openai/text-embedding-3-small
# Empty means reuse LLM_API_KEY with the same ProxyAPI endpoint.
EMBEDDER_API_KEY=
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=2
EMBEDDING_CACHE_DIR=/cache

CORPUS_DIR_HOST=../files/corpus
REQUESTS_PER_MINUTE=120
MAX_BODY_BYTES=32768
